---
interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, path = "/", jsonLd, ogImage = "/images/hero-home.webp" } = Astro.props;
const site = "https://hotel-menu-guide.pages.dev";
const canonical = new URL(path, site).toString();

// States with hotel-restaurant coverage. Add a new { label, href } entry
// here and it appears in the desktop dropdown, the mobile menu, and (via
// the pillar pages) the /states/ index — no other changes needed.
const states = [
  { label: "New York", href: "/best-hotel-restaurants-nyc/" },
  { label: "Ohio", href: "/best-hotel-restaurants-ohio/" },
  { label: "California", href: "/best-hotel-restaurants-california/" },
  { label: "Nevada", href: "/best-hotel-restaurants-nevada/" },
  { label: "Illinois", href: "/best-hotel-restaurants-illinois/" },
  { label: "Florida", href: "/best-hotel-restaurants-florida/" },
];

// Individual hotel-restaurant guides, grouped by state. Add a new
// { label, href } entry here and it appears in the desktop "Restaurants"
// dropdown and the mobile expandable panel — no other changes needed.
const restaurants = [
  {
    state: "New York",
    guides: [
      { label: "The Mark", href: "/the-mark-menu/" },
      { label: "Palm Court", href: "/plaza-palm-court-menu/" },
