---
interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, path = "/", jsonLd, ogImage = "/images/hero-home.webp" } = Astro.props;
const site = "https://hotel-menu-guide.pages.dev";
const canonical = new URL(path, site).toString();

// States with hotel-restaurant coverage. Add a new { label, href } entry
// here and it appears in the desktop dropdown, the mobile menu, and (via
// the pillar pages) the /states/ index — no other changes needed.
const states = [
  { label: "New York", href: "/best-hotel-restaurants-nyc/" },
  { label: "Ohio", href: "/best-hotel-restaurants-ohio/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23211d16'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='18' fill='%23a3802e' text-anchor='middle'%3EM%3C/text%3E%3C/svg%3E" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-line bg-cream/95 backdrop-blur sticky top-0 z-50">
      <nav class="max-w-5xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16" aria-label="Main navigation">
        <a href="/" class="font-display text-xl sm:text-2xl font-bold tracking-tight text-ink">
          Hotel Menu <span class="text-gold">Guide</span>
        </a>
        <ul class="hidden md:flex items-center gap-6 text-sm font-medium text-ink-soft">
          <li><a href="/" class="hover:text-gold-dark transition-colors">Home</a></li>
          <li><a href="/the-mark-menu/" class="hover:text-gold-dark transition-colors">The Mark</a></li>
          <li><a href="/plaza-palm-court-menu/" class="hover:text-gold-dark transition-colors">Palm Court</a></li>
          <li class="relative" data-dropdown>
            <button
              type="button"
              data-dropdown-button
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="states-menu-desktop"
              class="inline-flex items-center gap-1 hover:text-gold-dark transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-dark rounded-sm cursor-pointer"
            >
              States
              <svg data-dropdown-chevron class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 6l4 4 4-4" />
              </svg>
            </button>
            <ul
              id="states-menu-desktop"
              data-dropdown-menu
              role="menu"
              aria-label="States"
              hidden
              class="absolute left-0 top-full mt-2 w-60 rounded-xl border border-line bg-white py-2 shadow-lg"
            >
              {states.map((s) => (
                <li role="none">
                  <a
                    role="menuitem"
                    href={s.href}
                    class="block px-4 py-2 text-sm text-ink-soft hover:bg-parchment hover:text-gold-dark focus-visible:outline-2 focus-visible:outline-gold-dark"
                  >
                    {s.label}
                  </a>
                </li>
              ))}
              <li role="none" class="mt-1 border-t border-line pt-1">
                <a
                  role="menuitem"
                  href="/states/"
                  class="block px-4 py-2 text-sm font-semibold text-gold-dark hover:bg-parchment focus-visible:outline-2 focus-visible:outline-gold-dark"
                >
                  All states →
                </a>
              </li>
            </ul>
          </li>
          <li><a href="/about/" class="hover:text-gold-dark transition-colors">About</a></li>
          <li><a href="/contact/" class="hover:text-gold-dark transition-colors">Contact</a></li>
        </ul>
        <a href="/the-mark-menu/" class="md:hidden text-sm font-medium text-gold-dark border border-gold rounded-full px-4 py-1.5">
          Guides
        </a>
      </nav>
      <nav class="md:hidden border-t border-line" aria-label="Mobile navigation" data-dropdown>
        <ul class="max-w-5xl mx-auto px-4 py-2.5 flex gap-5 text-sm text-ink-soft overflow-x-auto whitespace-nowrap">
          <li><a href="/" class="hover:text-gold-dark">Home</a></li>
          <li>
            <button
              type="button"
              data-dropdown-button
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="states-menu-mobile"
              class="inline-flex items-center gap-1 hover:text-gold-dark focus-visible:outline-2 focus-visible:outline-gold-dark rounded-sm cursor-pointer"
            >
              States
              <svg data-dropdown-chevron class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 6l4 4 4-4" />
              </svg>
            </button>
          </li>
          <li><a href="/the-mark-menu/" class="hover:text-gold-dark">The Mark</a></li>
          <li><a href="/plaza-palm-court-menu/" class="hover:text-gold-dark">Palm Court</a></li>
          <li><a href="/about/" class="hover:text-gold-dark">About</a></li>
          <li><a href="/contact/" class="hover:text-gold-dark">Contact</a></li>
        </ul>
        <div id="states-menu-mobile" data-dropdown-menu hidden class="border-t border-line bg-white">
          <ul class="max-w-5xl mx-auto px-4 py-2 text-sm" aria-label="States">
            {states.map((s) => (
              <li>
                <a href={s.href} class="block py-2.5 text-ink-soft hover:text-gold-dark border-b border-line/60 last:border-0">
                  {s.label}
                </a>
              </li>
            ))}
            <li>
              <a href="/states/" class="block py-2.5 font-semibold text-gold-dark">
                All states →
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-ink text-cream mt-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid gap-8 md:grid-cols-3">
          <div>
            <p class="font-display text-xl font-bold">Hotel Menu <span class="text-gold">Guide</span></p>
            <p class="mt-3 text-sm text-cream/70 leading-relaxed">
              Independent, original guides to the menus of the most famous hotel restaurants
              in New York and Ohio. Prices reported as of 2026 — always verify with the
              restaurant before visiting.
            </p>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-gold mb-4">Guides</p>
            <ul class="space-y-2 text-sm text-cream/80">
              <li><a href="/states/" class="hover:text-gold transition-colors">Browse Guides by State</a></li>
              <li><a href="/best-hotel-restaurants-nyc/" class="hover:text-gold transition-colors">Best Hotel Restaurants in NYC</a></li>
              <li><a href="/the-mark-menu/" class="hover:text-gold transition-colors">The Mark Restaurant — Menu Guide</a></li>
              <li><a href="/plaza-palm-court-menu/" class="hover:text-gold transition-colors">The Palm Court Afternoon Tea — Guide</a></li>
              <li><a href="/king-cole-bar-menu/" class="hover:text-gold transition-colors">King Cole Bar — Menu Guide</a></li>
              <li><a href="/cafe-carlyle-menu/" class="hover:text-gold transition-colors">Café Carlyle — Menu Guide</a></li>
              <li><a href="/locanda-verde-menu/" class="hover:text-gold transition-colors">Locanda Verde — Menu Guide</a></li>
              <li><a href="/temple-court-menu/" class="hover:text-gold transition-colors">Temple Court — Menu Guide</a></li>
              <li><a href="/majorelle-menu/" class="hover:text-gold transition-colors">Majorelle — Menu Guide</a></li>
              <li><a href="/perrine-menu/" class="hover:text-gold transition-colors">Perrine — Menu Guide</a></li>
              <li><a href="/best-hotel-restaurants-ohio/" class="hover:text-gold transition-colors">Best Hotel Restaurants in Ohio</a></li>
              <li><a href="/metropole-menu/" class="hover:text-gold transition-colors">Metropole — Menu Guide</a></li>
              <li><a href="/burnham-menu/" class="hover:text-gold transition-colors">The Burnham — Menu Guide</a></li>
              <li><a href="/adega-menu/" class="hover:text-gold transition-colors">Adega — Menu Guide</a></li>
              <li><a href="/turn-bar-kitchen-menu/" class="hover:text-gold transition-colors">TURN Bar + Kitchen — Menu Guide</a></li>
              <li><a href="/guild-house-menu/" class="hover:text-gold transition-colors">The Guild House — Menu Guide</a></li>
              <li><a href="/keep-menu/" class="hover:text-gold transition-colors">The Keep Kitchen &amp; Liquor Bar — Menu Guide</a></li>
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-gold mb-4">Site</p>
            <ul class="space-y-2 text-sm text-cream/80">
              <li><a href="/about/" class="hover:text-gold transition-colors">About</a></li>
              <li><a href="/contact/" class="hover:text-gold transition-colors">Contact</a></li>
              <li><a href="/privacy-policy/" class="hover:text-gold transition-colors">Privacy Policy</a></li>
              <li><a href="/terms-of-service/" class="hover:text-gold transition-colors">Terms of Service</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 pt-6 border-t border-cream/15 text-xs text-cream/50 flex flex-col sm:flex-row justify-between gap-2">
          <p>© 2026 Hotel Menu Guide. All content original.</p>
          <p>Not affiliated with any hotel or restaurant mentioned.</p>
        </div>
      </div>
    </footer>

    <script>
      // States dropdowns (desktop + mobile): click to toggle, Escape closes,
      // outside click closes, focus leaving the dropdown closes it.
      (function () {
        var dropdowns = document.querySelectorAll("[data-dropdown]");

        function setOpen(dropdown, open) {
          var button = dropdown.querySelector("[data-dropdown-button]");
          var menu = dropdown.querySelector("[data-dropdown-menu]");
          var chevron = dropdown.querySelector("[data-dropdown-chevron]");
          if (!button || !menu) return;
          menu.hidden = !open;
          button.setAttribute("aria-expanded", open ? "true" : "false");
          if (chevron) chevron.classList.toggle("rotate-180", open);
        }

        function closeAll() {
          dropdowns.forEach(function (d) {
            setOpen(d, false);
          });
        }

        dropdowns.forEach(function (dropdown) {
          var button = dropdown.querySelector("[data-dropdown-button]");
          var menu = dropdown.querySelector("[data-dropdown-menu]");
          if (!button || !menu) return;

          button.addEventListener("click", function (e) {
            e.stopPropagation();
            var willOpen = menu.hidden;
            closeAll();
            setOpen(dropdown, willOpen);
          });

          dropdown.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
              setOpen(dropdown, false);
              button.focus();
            }
          });

          dropdown.addEventListener("focusout", function (e) {
            if (!dropdown.contains(e.relatedTarget)) setOpen(dropdown, false);
          });
        });

        document.addEventListener("click", function (e) {
          dropdowns.forEach(function (d) {
            if (!d.contains(e.target)) setOpen(d, false);
          });
        });

        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") closeAll();
        });
      })();
    </script>
  </body>
</html>
