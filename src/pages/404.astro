---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Page Not Found — Hotel Menu Guide"
  description="The page you're looking for doesn't exist. Browse our hotel restaurant menu guides instead."
  path="/404/"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center">
    <p class="font-display text-7xl font-bold text-gold">404</p>
    <h1 class="font-display text-2xl sm:text-3xl font-bold mt-4">This course isn't on the menu.</h1>
    <p class="mt-4 text-ink-soft">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="rounded-full bg-ink text-cream px-6 py-3 text-sm font-semibold hover:bg-gold-dark transition-colors">Back to home</a>
      <a href="/the-mark-menu/" class="rounded-full border border-gold text-gold-dark px-6 py-3 text-sm font-semibold hover:bg-gold/10 transition-colors">The Mark guide</a>
    </div>
  </div>
</BaseLayout>
