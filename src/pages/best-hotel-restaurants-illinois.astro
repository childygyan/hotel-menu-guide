---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Best Hotel Restaurants in Illinois",
  description:
    "Our picks for the best hotel restaurants in Illinois, each with an original menu guide.",
  itemListElement: [
    { "@type": "ListItem", position: 1, url: "https://hotel-menu-guide.pages.dev/shanghai-terrace-menu/", name: "Shanghai Terrace at The Peninsula Chicago" },
    { "@type": "ListItem", position: 2, url: "https://hotel-menu-guide.pages.dev/travelle-menu/", name: "Travelle at The Langham Chicago" },
    { "@type": "ListItem", position: 3, url: "https://hotel-menu-guide.pages.dev/adorn-menu/", name: "Adorn at Four Seasons Hotel Chicago" },
    { "@type": "ListItem", position: 4, url: "https://hotel-menu-guide.pages.dev/torali-menu/", name: "Torali at The Ritz-Carlton, Chicago" },
    { "@type": "ListItem", position: 5, url: "https://hotel-menu-guide.pages.dev/cindys-menu/", name: "Cindy's at Chicago Athletic Association" },
    { "@type": "ListItem", position: 6, url: "https://hotel-menu-guide.pages.dev/the-ives-menu/", name: "The Ives at Chicago Athletic Association" },
  ],
};

const guides = [
  {
    href: "/shanghai-terrace-menu/",
    img: "/images/shanghai-terrace-dining.webp",
    alt: "Illustration of an elegant Cantonese dining room with red lanterns and skyline views",
    tag: "Chicago · The Peninsula",
    title: "Shanghai Terrace",
    text: "The Peninsula's Cantonese dining room — the signature Peking duck reported around $78, dim sum from $16, and one of Chicago's great hotel views. Our guide walks through the menu highlights.",
  },
  {
    href: "/travelle-menu/",
    img: "/images/travelle-dining.webp",
    alt: "Illustration of a chic bistro dining room with river views at evening",
    tag: "Chicago · The Langham",
    title: "Travelle",
    text: "The Langham's river-view bistro — the $48 lobster eggs Benedict, Petrossian caviar service, and current official menu prices we verified. Our guide covers breakfast through dinner.",
  },
  {
    href: "/adorn-menu/",
    img: "/images/adorn-dining.webp",
    alt: "Illustration of a refined modern hotel dining room with jewel tones",
    tag: "Chicago · Four Seasons",
    title: "Adorn",
    text: "Four Seasons Chicago's 7th-floor dining room — the successor to the closed Allium, with a 4.8-star OpenTable following and jewel-toned dining room. Our guide covers the menu and the room.",
  },
  {
    href: "/torali-menu/",
    img: "/images/torali-dining.webp",
    alt: "Illustration of a bright modern Italian dining room with marble tables",
    tag: "Chicago · The Ritz-Carlton",
    title: "Torali",
    text: "The Ritz-Carlton's modern Italian restaurant — antipasti $16–$24, pastas $28–$32, and steaks to $58, all from the official menu we fetched. Our guide covers dinner, lunch, and breakfast.",
  },
  {
    href: "/cindys-menu/",
    img: "/images/cindys-dining.webp",
    alt: "Illustration of a glass-enclosed rooftop restaurant overlooking the city at sunset",
    tag: "Chicago · Chicago Athletic Association",
    title: "Cindy's",
    text: "The glass-atrium rooftop at the Chicago Athletic Association — Millennium Park views, an OpenTable band of $31–$50 per person, and Boka Restaurant Group cooking. Our guide covers the scene and the menu.",
  },
  {
    href: "/the-ives-menu/",
    img: "/images/the-ives-dining.webp",
    alt: "Illustration of a moody modern grill room with dark wood and brass lighting",
    tag: "Chicago · Chicago Athletic Association",
    title: "The Ives",
    text: "The modern grill room that replaced Cherry Circle Room in May 2026 — tableside-carved wagyu prime rib around $82, a $38 roving relish cart, and chef-partner Chris Pandel. Our guide has the details.",
  },
];
---

<BaseLayout
  title="Best Hotel Restaurants in Illinois — 6 Great Guides"
  description="Our picks for the best hotel restaurants in Illinois: Shanghai Terrace, Travelle, Adorn, Torali, Cindy's, and The Ives — each with an original menu guide."
  path="/best-hotel-restaurants-illinois/"
  jsonLd={jsonLd}
  ogImage="/images/illinois-hotel-dining.webp"
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6">
    <img
      src="/images/illinois-hotel-dining.webp"
      alt="Illustration of a grand Chicago hotel dining room at dusk with skyline views"
      class="w-full h-64 sm:h-96 object-cover rounded-2xl mt-8"
      fetchpriority="high"
    />
    <p class="mt-10 text-xs font-semibold uppercase tracking-widest text-gold-dark">
      Pillar Guide · Illinois
    </p>
    <h1 class="font-display text-3xl sm:text-5xl font-bold mt-2 leading-tight max-w-3xl">
      The Best Hotel Restaurants in Illinois
    </h1>
    <p class="mt-4 text-lg text-ink-soft leading-relaxed max-w-3xl">
      Illinois means Chicago, and Chicago's grand hotels hold some of America's great
      dining rooms: a Cantonese palace at the Peninsula, a river-view bistro at the
      Langham, a jewel-box dining room at the Four Seasons, modern Italian at the
      Ritz-Carlton, and a rooftop plus a grill room inside the landmark Chicago Athletic
      Association. We've written an original, independent guide to each of the six below:
      what the menu looks like, what it costs, and what we'd order. Prices are reported
      figures, dated honestly — never copied menus.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {guides.map((g) => (
        <a
          href={g.href}
          class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
        >
          <img
            src={g.img}
            alt={g.alt}
            class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
            loading="lazy"
          />
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">{g.tag}</p>
            <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
              {g.title}
            </h2>
            <p class="mt-3 text-ink-soft text-sm leading-relaxed">{g.text}</p>
            <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Read the guide →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 rounded-2xl bg-parchment border border-line p-6 sm:p-10">
      <h2 class="font-display text-2xl sm:text-3xl font-bold">How we chose these six</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3 text-sm leading-relaxed text-ink-soft">
        <div>
          <h3 class="font-display text-lg font-bold text-ink mb-2">Search interest, then notability</h3>
          <p>
            We checked Google Trends (United States, past 12 months) for hotel-restaurant
            menu queries across five states. Illinois won with a mean of 2.4 — "travelle
            chicago menu" averaged 3.2 and "shanghai terrace menu" 1.6 — ahead of Texas
            (1.4), South Carolina (1.3), and Louisiana (0.6). Both leaders headline this
            list; the rest earned their spots through awards, press, and history.
          </p>
        </div>
        <div>
          <h3 class="font-display text-lg font-bold text-ink mb-2">One city, six rooms</h3>
          <p>
            All six are in Chicago — the Peninsula, the Langham, the Four Seasons, the
            Ritz-Carlton, and the Chicago Athletic Association (twice). That's where
            Illinois's hotel dining lives, from Cantonese fine dining to a glass rooftop
            thirteen floors up.
          </p>
        </div>
        <div>
          <h3 class="font-display text-lg font-bold text-ink mb-2">Original writing, always</h3>
          <p>
            We never copy a restaurant's menu text or photos. Every guide is written in our own words
            from publicly reported facts — prices dated honestly, with a nudge to verify before you visit.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-10 rounded-xl border border-gold/40 bg-gold/10 p-5 sm:p-6 text-sm text-ink-soft leading-relaxed">
      <p class="font-semibold text-ink mb-1">A note on prices</p>
      <p>
        All prices on this site are <strong>reported as of 2026</strong>, gathered from the
        restaurants' official published materials and reputable public sources. Menus and prices change
        frequently — please verify with the restaurant before visiting.
      </p>
    </div>
  </article>
</BaseLayout>
