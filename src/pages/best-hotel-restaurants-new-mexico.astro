---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Best Hotel Restaurants in New Mexico",
  description:
    "Our picks for the best hotel restaurants in New Mexico, each with an original menu guide.",
  itemListElement: [
    { "@type": "ListItem", position: 1, url: "https://hotel-menu-guide.pages.dev/la-plazuela-menu/", name: "La Plazuela at La Fonda on the Plaza" },
    { "@type": "ListItem", position: 2, url: "https://hotel-menu-guide.pages.dev/anasazi-restaurant-menu/", name: "Anasazi Restaurant at Rosewood Inn of the Anasazi" },
    { "@type": "ListItem", position: 3, url: "https://hotel-menu-guide.pages.dev/agave-menu/", name: "Agave at Eldorado Hotel & Spa" },
    { "@type": "ListItem", position: 4, url: "https://hotel-menu-guide.pages.dev/terra-menu/", name: "Terra at Four Seasons Resort Rancho Encantado Santa Fe" },
    { "@type": "ListItem", position: 5, url: "https://hotel-menu-guide.pages.dev/julia-menu/", name: "Julia at La Posada de Santa Fe" },
    { "@type": "ListItem", position: 6, url: "https://hotel-menu-guide.pages.dev/level-5-menu/", name: "Level 5 at Hotel Chaco" },
  ],
};

const guides = [
  {
    href: "/la-plazuela-menu/",
    img: "/images/la-plazuela-dining.webp",
    alt: "Illustration of a historic Santa Fe Southwestern restaurant dining room with adobe walls, a glowing kiva fireplace, Talavera tiles and candlelit tables at evening (illustrative, not the actual restaurant)",
    tag: "Santa Fe · La Fonda on the Plaza",
    title: "La Plazuela",
    text: "The landmark Plaza hotel's sunlit Southwestern dining room — tableside guacamole, lobster red chile bisque, and Hatch chile rellenos, with the honest note that no regular menu prices are published.",
  },
  {
    href: "/anasazi-restaurant-menu/",
    img: "/images/anasazi-restaurant-dining.webp",
    alt: "Illustration of a refined contemporary Southwestern fine-dining room with adobe tones, a sculptural kiva fireplace, Native-inspired modern art and white tablecloths at dusk (illustrative, not the actual restaurant)",
    tag: "Santa Fe · Rosewood Inn of the Anasazi",
    title: "Anasazi Restaurant",
    text: "Chef Cristian Pontiggia's refined Southwestern room a block from the Plaza — the famous mushroom cappuccino, bison carpaccio, and real official menu prices (current in-room menu).",
  },
  {
    href: "/agave-menu/",
    img: "/images/agave-dining.webp",
    alt: "Illustration of a lively Santa Fe hotel lounge with a Southwestern bar, turquoise accents, margaritas on the counter, string lights and small plates at evening (illustrative, not the actual restaurant)",
    tag: "Santa Fe · Eldorado Hotel & Spa",
    title: "Agave",
    text: "Eldorado's Southwestern lounge and the home of Santa Fe's famous happy hour — official September 2026 happy-hour prices, replacing the closed Old House.",
  },
  {
    href: "/terra-menu/",
    img: "/images/terra-dining.webp",
    alt: "Illustration of a desert-modern resort restaurant with panoramic mountain views, a heated patio with fire pits and warm dusk light (illustrative, not the actual restaurant)",
    tag: "Santa Fe · Four Seasons Rancho Encantado",
    title: "Terra",
    text: "Chef Andrew Fox's high-desert dining room with Sangre de Cristo views — the Steak For Two signature and official March 2026 breakfast prices, with an honest flag on conflicting hours.",
  },
  {
    href: "/julia-menu/",
    img: "/images/julia-dining.webp",
    alt: "Illustration of a 19th-century Victorian mansion dining room with vintage elegance, a garden patio with kiva fireplaces and candlelit tables at evening (illustrative, not the actual restaurant)",
    tag: "Santa Fe · La Posada de Santa Fe",
    title: "Julia",
    text: "Southwestern-American comfort inside Julia Staab's 1882 Victorian mansion — duck breast, chicken corn chowder, and the Juliarita, with the honest note that no menu prices are published.",
  },
  {
    href: "/level-5-menu/",
    img: "/images/level-5-dining.webp",
    alt: "Illustration of a rooftop restaurant at dusk with Sandia Mountain and city views, modern lounge seating, fire features and candlelit tables (illustrative, not the actual restaurant)",
    tag: "Albuquerque · Hotel Chaco",
    title: "Level 5",
    text: "Albuquerque's rooftop dining room with panoramic Sandia views — chef Goran Basarov's Matanza suckling pig and green-chile brunch plates, with no regular prices published.",
  },
];
---

<BaseLayout
  title="Best Hotel Restaurants in New Mexico — 6 Great Guides"
  description="Our picks for the best hotel restaurants in New Mexico: La Plazuela, Anasazi Restaurant, Agave, Terra, Julia, and Level 5 — each with an original menu guide."
  path="/best-hotel-restaurants-new-mexico/"
  jsonLd={jsonLd}
  ogImage="/images/new-mexico-hotel-dining.webp"
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6">
    <img
      src="/images/new-mexico-hotel-dining.webp"
      alt="Illustration of a grand historic Santa Fe luxury hotel dining room with adobe ceilings, kiva fireplaces, wrought-iron chandeliers and candlelit tables at evening (illustrative, not the actual restaurants)"
      class="w-full h-64 sm:h-96 object-cover rounded-2xl mt-8"
      fetchpriority="high"
    />
    <p class="mt-10 text-xs font-semibold uppercase tracking-widest text-gold-dark">
      Pillar Guide · New Mexico
    </p>
    <h1 class="font-display text-3xl sm:text-5xl font-bold mt-2 leading-tight max-w-3xl">
      The Best Hotel Restaurants in New Mexico
    </h1>
    <p class="mt-3 text-sm text-ink-soft">By <span class="font-semibold text-ink">Firoz Khan</span> <span class="text-gold-dark">&middot;</span> FK Digital Media</p>
    <p class="mt-4 text-lg text-ink-soft leading-relaxed max-w-3xl">
      Santa Fe is the Southwest's great hotel-dining city, and these are the six
      rooms we'd send a friend to first: La Plazuela's courtyard Southwestern
      classics at La Fonda on the Plaza, the decorated Anasazi Restaurant at
      Rosewood Inn of the Anasazi, Agave's famous happy hour at Eldorado Hotel
      &amp; Spa, Terra's mountain-view dining at Four Seasons Rancho Encantado,
      Julia's mansion-set comfort food at La Posada, and Level 5's rooftop at
      Hotel Chaco in Albuquerque. We've written an original, independent guide to
      each: what the menu looks like, what it costs, and what we'd order. Prices
      are reported figures, dated honestly — never copied menus.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {guides.map((g) => (
        <a
          href={g.href}
          class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
        >
          <img
            src={g.img}
            alt={g.alt}
            class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
            loading="lazy"
          />
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">{g.tag}</p>
            <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
              {g.title}
            </h2>
            <p class="mt-3 text-ink-soft text-sm leading-relaxed">{g.text}</p>
            <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Read the guide →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 rounded-2xl bg-parchment border border-line p-6 sm:p-10">
      <h2 class="font-display text-2xl sm:text-3xl font-bold">How we chose these six</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3 text-sm leading-relaxed text-ink-soft">
        <div>
          <p class="font-semibold text-ink mb-2">Search interest</p>
          <p>
            We research every expansion state with Google Trends (US, 12 months)
            before writing a word. New Mexico posted a state mean of
            <strong>2.0</strong> in our October 2026 research — ahead of Indiana,
            Oklahoma, and Utah (1.0 each), Alabama (0), and the already-built
            South Carolina (1.3). One honest caveat: the interest is spike-driven
            — "anasazi restaurant santa fe menu" scored 4 on December 2025 and May
            2026 spikes, while "la plazuela santa fe menu" sat at zero all year.
            Real curiosity, but lumpy.
          </p>
        </div>
        <div>
          <p class="font-semibold text-ink mb-2">Verified open — two substitutions</p>
          <p>
            All six were verified open in October 2026 against official sites,
            active reservation listings, and recent review activity. Two
            substitutions: The Old House at Eldorado closed → replaced by
            <strong>Agave</strong> at the same hotel; MÁS Tapas y Vino at Hotel
            Andaluz is permanently closed (its replacement Char was verified, but
            Level 5 is our Albuquerque pick).
          </p>
        </div>
        <div>
          <p class="font-semibold text-ink mb-2">Our honesty rules</p>
          <p>
            Every guide is written in our own words from official and verified
            sources. Prices are labeled with their date and source — Anasazi's
            are official and current (in-room menu), Agave's are official
            September 2026 happy-hour prices, Terra's breakfast figures are
            March 2026 era, and where a restaurant publishes no prices (La
            Plazuela, Julia, Level 5), we say so plainly instead of guessing.
          </p>
        </div>
      </div>
    </div>

    <p class="mt-8 text-sm text-ink-soft">
      <a href="/" class="text-gold-dark font-semibold hover:underline">← Back to all guides</a>
    </p>
  </article>
</BaseLayout>
