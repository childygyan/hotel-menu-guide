---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Best Hotel Restaurants in Texas",
  description:
    "Our picks for the best hotel restaurants in Texas, each with an original menu guide.",
  itemListElement: [
    { "@type": "ListItem", position: 1, url: "https://hotel-menu-guide.pages.dev/fearings-menu/", name: "Fearing's at The Ritz-Carlton, Dallas" },
    { "@type": "ListItem", position: 2, url: "https://hotel-menu-guide.pages.dev/french-room-menu/", name: "The French Room at The Adolphus, Dallas" },
    { "@type": "ListItem", position: 3, url: "https://hotel-menu-guide.pages.dev/mansion-restaurant-menu/", name: "The Mansion Restaurant at Rosewood Mansion on Turtle Creek, Dallas" },
    { "@type": "ListItem", position: 4, url: "https://hotel-menu-guide.pages.dev/supper-menu/", name: "Supper at Hotel Emma, San Antonio" },
    { "@type": "ListItem", position: 5, url: "https://hotel-menu-guide.pages.dev/1886-cafe-menu/", name: "1886 Café & Bakery at The Driskill, Austin" },
    { "@type": "ListItem", position: 6, url: "https://hotel-menu-guide.pages.dev/geraldines-menu/", name: "Geraldine's at Hotel Van Zandt, Austin" },
  ],
};

const guides = [
  {
    href: "/fearings-menu/",
    img: "/images/fearings-dining.webp",
    alt: "Illustration of an elegant Southwestern restaurant dining room with warm lighting at evening (illustrative, not the actual restaurant)",
    tag: "Dallas · The Ritz-Carlton",
    title: "Fearing's",
    text: "Dean Fearing's Southwestern flagship — the famous tortilla soup ($17), mesquite-grilled Wagyu steaks to $91, and a Michelin Recommended listing in the Texas guide. Our guide walks through the official menu prices.",
  },
  {
    href: "/french-room-menu/",
    img: "/images/french-room-dining.webp",
    alt: "Illustration of a grand historic European-style dining room with chandeliers at evening (illustrative, not the actual restaurant)",
    tag: "Dallas · The Adolphus",
    title: "The French Room",
    text: "The 1912 landmark dining room, now home to afternoon tea ($75 per person) and the French Room Bar's modern-French dinner menu. Our guide covers what's actually on offer in 2026.",
  },
  {
    href: "/mansion-restaurant-menu/",
    img: "/images/mansion-restaurant-dining.webp",
    alt: "Illustration of a stately elegant dining room in a historic Southern mansion at evening (illustrative, not the actual restaurant)",
    tag: "Dallas · Rosewood",
    title: "The Mansion Restaurant",
    text: "The historic dining room of Rosewood Mansion on Turtle Creek — where Dean Fearing made his name — with a seven-course Discovery Tasting Menu under chef Charles Olalia. Our guide covers the menu and the room.",
  },
  {
    href: "/supper-menu/",
    img: "/images/supper-dining.webp",
    alt: "Illustration of a rustic-chic restaurant inside a historic brewery building with exposed brick at evening (illustrative, not the actual restaurant)",
    tag: "San Antonio · Hotel Emma",
    title: "Supper",
    text: "Chef John Brand's restaurant in the 1894 Pearl brewery — a serious steak program (ribeye $68), osetra caviar, and breakfast-through-dinner service. Our guide has the official-menu prices.",
  },
  {
    href: "/1886-cafe-menu/",
    img: "/images/1886-cafe-dining.webp",
    alt: "Illustration of a charming historic hotel café with bakery cases and morning light (illustrative, not the actual restaurant)",
    tag: "Austin · The Driskill",
    title: "1886 Café & Bakery",
    text: "The Driskill's daypart café — the Texas-shaped pecan waffle ($15), chicken & waffles ($19), and the namesake 1886 chocolate cake ($8). Our guide covers the brunch menu and bakery case.",
  },
  {
    href: "/geraldines-menu/",
    img: "/images/geraldines-dining.webp",
    alt: "Illustration of a lively modern restaurant with a stage for live music at evening (illustrative, not the actual restaurant)",
    tag: "Austin · Hotel Van Zandt",
    title: "Geraldine's",
    text: "Hotel Van Zandt's modern-Mexican restaurant with live music — a $39.99 Dinner Before Dark prix fixe, weekend jazz brunch, and 48-hour short rib in mole negro. Our guide has the details.",
  },
];
---

<BaseLayout
  title="Best Hotel Restaurants in Texas — 6 Great Guides"
  description="Our picks for the best hotel restaurants in Texas: Fearing's, The French Room, The Mansion Restaurant, Supper, 1886 Café & Bakery, and Geraldine's — each with an original menu guide."
  path="/best-hotel-restaurants-texas/"
  jsonLd={jsonLd}
  ogImage="/images/texas-hotel-dining.webp"
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6">
    <img
      src="/images/texas-hotel-dining.webp"
      alt="Illustration of a grand Texas hotel dining room at evening (illustrative, not the actual restaurant)"
      class="w-full h-64 sm:h-96 object-cover rounded-2xl mt-8"
      fetchpriority="high"
    />
    <p class="mt-10 text-xs font-semibold uppercase tracking-widest text-gold-dark">
      Pillar Guide · Texas
    </p>
    <h1 class="font-display text-3xl sm:text-5xl font-bold mt-2 leading-tight max-w-3xl">
      The Best Hotel Restaurants in Texas
    </h1>
    <p class="mt-4 text-lg text-ink-soft leading-relaxed max-w-3xl">
      Texas's great hotel dining rooms span three cities: Dean Fearing's Southwestern
      flagship and the landmark French Room in Dallas, the historic Mansion Restaurant at
      Rosewood's birthplace, Supper in San Antonio's 1894 Pearl brewery, and two Austin
      institutions — 1886 Café &amp; Bakery at The Driskill and Geraldine's at Hotel Van
      Zandt. We've written an original, independent guide to each of the six below: what
      the menu looks like, what it costs, and what we'd order. Prices are reported
      figures, dated honestly — never copied menus.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {guides.map((g) => (
        <a
          href={g.href}
          class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
        >
          <img
            src={g.img}
            alt={g.alt}
            class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
            loading="lazy"
          />
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">{g.tag}</p>
            <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
              {g.title}
            </h2>
            <p class="mt-3 text-ink-soft text-sm leading-relaxed">{g.text}</p>
            <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Read the guide →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 rounded-2xl bg-parchment border border-line p-6 sm:p-10">
      <h2 class="font-display text-2xl sm:text-3xl font-bold">How we chose these six</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3 text-sm leading-relaxed text-ink-soft">
        <div>
          <p class="font-semibold text-ink mb-2">Search interest</p>
          <p>
            We research every expansion state with Google Trends (US, 12 months) before
            writing a word. For Texas, the state mean was <strong>1.4</strong>, with
            <strong>"french room dallas menu" at 3.0</strong>, <strong>"fearings menu" at
            1.1</strong>, and <strong>"supper san antonio menu" at 0.1</strong> —
            confirming steady, if modest, search demand for these dining rooms.
          </p>
        </div>
        <div>
          <p class="font-semibold text-ink mb-2">All verified open</p>
          <p>
            Every restaurant here was verified open in October 2026 against its official
            site, an active reservation listing, and recent review activity. Where a
            restaurant changed format — the French Room's move to afternoon tea plus the
            Bar — we describe what's actually on offer now, not the historic version.
          </p>
        </div>
        <div>
          <p class="font-semibold text-ink mb-2">Our honesty rules</p>
          <p>
            Every guide is written in our own words from official and verified sources.
            Prices are labeled with their date and source — and where a restaurant
            publishes no prices (The Mansion Restaurant, Geraldine's), we say so plainly
            instead of guessing.
          </p>
        </div>
      </div>
    </div>

    <p class="mt-8 text-sm text-ink-soft">
      <a href="/" class="text-gold-dark font-semibold hover:underline">← Back to all guides</a>
    </p>
  </article>
</BaseLayout>
