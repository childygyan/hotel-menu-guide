---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Hotel Restaurant Guides by State",
  description:
    "Original guides to famous hotel restaurant menus, organized by US state.",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "New York",
      url: "https://hotel-menu-guide.pages.dev/best-hotel-restaurants-nyc/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Ohio",
      url: "https://hotel-menu-guide.pages.dev/best-hotel-restaurants-ohio/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "California",
      url: "https://hotel-menu-guide.pages.dev/best-hotel-restaurants-california/",
    },
    {
      "@type": "ListItem",
      position: 4,
      name: "Nevada",
      url: "https://hotel-menu-guide.pages.dev/best-hotel-restaurants-nevada/",
    },
    {
      "@type": "ListItem",
      position: 5,
      name: "Illinois",
      url: "https://hotel-menu-guide.pages.dev/best-hotel-restaurants-illinois/",
    },
    {
      "@type": "ListItem",
      position: 6,
      name: "Florida",
      url: "https://hotel-menu-guide.pages.dev/best-hotel-restaurants-florida/",
    },
    {
      "@type": "ListItem",
      position: 7,
      name: "Texas",
      url: "https://hotel-menu-guide.pages.dev/best-hotel-restaurants-texas/",
    },
    {
      "@type": "ListItem",
      position: 8,
      name: "Tennessee",
      url: "https://hotel-menu-guide.pages.dev/best-hotel-restaurants-tennessee/",
    },
    {
      "@type": "ListItem",
      position: 9,
      name: "Minnesota",
      url: "https://hotel-menu-guide.pages.dev/best-hotel-restaurants-minnesota/",
    },
    {
      "@type": "ListItem",
      position: 10,
      name: "South Carolina",
      url: "https://hotel-menu-guide.pages.dev/best-hotel-restaurants-south-carolina/",
    },
  ],
};
---

<BaseLayout
  title="Browse Hotel Restaurant Guides by State"
  description="Browse our original hotel restaurant menu guides by US state. New York, Ohio, California, Nevada, Illinois, Florida, Texas, Tennessee, Minnesota, and South Carolina covered so far — more states on the way."
  path="/states/"
  jsonLd={jsonLd}
  ogImage="/images/hero-home.webp"
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6">
    <p class="mt-8 text-xs font-semibold uppercase tracking-widest text-gold-dark">
      Browse by State
    </p>
    <h1 class="font-display text-3xl sm:text-5xl font-bold mt-2 leading-tight">
      Hotel Restaurant Guides by State
    </h1>
    <p class="mt-4 text-lg text-ink-soft leading-relaxed">
      Pick a state to see every hotel restaurant we've covered there — each guide walks
      through the menu in our own words, with reported prices, what we'd order, and
      practical advice for planning your visit. Prices are reported figures, not copies
      of restaurant menus, and we always recommend confirming current prices with the
      restaurant itself.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <a
        href="/best-hotel-restaurants-nyc/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/hero-home.webp"
          alt="Illustration of an elegant New York hotel dining room at dusk"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">8 guides</p>
          <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            New York
          </h2>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            New York is where this project started — the city with the most famous hotel
            dining rooms in America, from the Upper East Side's clubby institutions to
            downtown's design hotels. Our eight guides cover The Mark, the Palm Court,
            King Cole Bar, Café Carlyle, and more.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Explore New York →</span>
        </div>
      </a>

      <a
        href="/best-hotel-restaurants-ohio/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/ohio-hotel-dining.webp"
          alt="Illustration of a grand Ohio hotel dining room"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">6 guides</p>
          <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            Ohio
          </h2>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            Ohio's hotel dining scene punches above its weight, from Cincinnati's
            art-filled 21c Museum Hotel to Cleveland's grand downtown dining rooms and
            Columbus's chef-driven kitchens. Our six guides span the state's three
            big cities, with menus, prices, and reservation tips.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Explore Ohio →</span>
        </div>
      </a>

      <a
        href="/best-hotel-restaurants-california/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/chateau-marmont-dining.webp"
          alt="Illustration of a glamorous California hotel dining terrace at dusk"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">6 guides</p>
          <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            California
          </h2>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            California's hotel dining rooms are the stuff of legend — the Chateau Marmont's
            star-filled dining room, the Polo Lounge's power-breakfast scene, and San
            Francisco's grand hotel institutions. Our six guides cover the menus, reported
            prices, and how to get a table.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Explore California →</span>
        </div>
      </a>

      <a
        href="/best-hotel-restaurants-nevada/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/nevada-hotel-dining.webp"
          alt="Illustration of a glamorous Las Vegas hotel dining terrace at dusk"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">6 guides</p>
          <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            Nevada
          </h2>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            Nevada won our search-interest comparison outright — and Las Vegas has the
            densest collection of great hotel restaurants in America. Our six guides cover
            Joël Robuchon, SW Steakhouse, Restaurant Guy Savoy, Nobu, Carbone, and Jean
            Georges Steakhouse, with menus, prices, and reservation tips.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Explore Nevada →</span>
        </div>
      </a>

      <a
        href="/best-hotel-restaurants-illinois/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/illinois-hotel-dining.webp"
          alt="Illustration of a grand Chicago hotel dining room at dusk with skyline views"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">6 guides</p>
          <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            Illinois
          </h2>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            Illinois won our search-interest comparison for the next state — and Chicago's
            grand hotels hold some of America's great dining rooms. Our six guides cover
            Shanghai Terrace, Travelle, Adorn, Torali, Cindy's, and The Ives, with menus,
            prices, and reservation tips.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Explore Illinois →</span>
        </div>
      </a>

      <a
        href="/best-hotel-restaurants-florida/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/florida-hotel-dining.webp"
          alt="Illustration of a grand Miami Beach hotel dining room with art deco details and ocean views (illustrative, not the actual restaurants)"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">6 guides</p>
          <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            Florida
          </h2>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            Florida ranked next in our search-interest research — and Miami Beach's resort
            hotels hold some of America's most famous dining rooms. Our six guides cover
            Jaya, Hakkasan, Prime 54, Pao, Nobu Miami Beach, and Los Fuegos, with menus,
            prices, and reservation tips.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Explore Florida →</span>
        </div>
      </a>

      <a
        href="/best-hotel-restaurants-texas/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/texas-hotel-dining.webp"
          alt="Illustration of a grand Texas hotel dining room at evening (illustrative, not the actual restaurants)"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">6 guides</p>
          <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            Texas
          </h2>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            Texas ranked next in our search-interest research — and Dallas, San Antonio,
            and Austin hold some of America's great hotel dining rooms. Our six guides
            cover Fearing's, The French Room, The Mansion Restaurant, Supper, 1886 Café
            &amp; Bakery, and Geraldine's, with menus, prices, and reservation tips.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Explore Texas →</span>
        </div>
      </a>

      <a
        href="/best-hotel-restaurants-tennessee/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/tennessee-hotel-dining.webp"
          alt="Illustration of a grand Nashville hotel dining room at evening (illustrative, not the actual restaurants)"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">6 guides</p>
          <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            Tennessee
          </h2>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            Tennessee won our latest search-interest research round — and Nashville's
            luxury hotels hold some of the South's great dining rooms. Our six guides
            cover Bourbon Steak, Drusie &amp; Darr, Marsh House, Henley, Yolan, and
            The Nashville Grange, with menus, prices, and reservation tips.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Explore Tennessee →</span>
        </div>
      </a>

      <a
        href="/best-hotel-restaurants-minnesota/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/minnesota-hotel-dining.webp"
          alt="Illustration of a grand Twin Cities luxury hotel dining room with high ceilings and chandeliers at evening (illustrative, not the actual restaurants)"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">6 guides</p>
          <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            Minnesota
          </h2>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            Minnesota won our latest search-interest research round — and the Twin
            Cities hold some of the Midwest's great hotel dining rooms. Our six guides
            cover Mara, St. Paul Grill, Tullibee, FireLake Grill House, Manny's
            Steakhouse, and Tavola, with menus, prices, and reservation tips.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Explore Minnesota →</span>
        </div>
      </a>

      <a
        href="/best-hotel-restaurants-south-carolina/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/south-carolina-hotel-dining.webp"
          alt="Illustration of a grand historic Charleston hotel dining room with high ceilings, chandeliers and tall windows at evening (illustrative, not the actual restaurants)"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">6 guides</p>
          <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            South Carolina
          </h2>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            Charleston is the South's great hotel-dining city — and the best
            remaining option in our search-interest research. Our six guides cover
            The Palmetto Cafe, Peninsula Grill, Circa 1886, Gabrielle, Iron Rose,
            and Frannie &amp; The Fox, with menus, prices, and reservation tips.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Explore South Carolina →</span>
        </div>
      </a>
    </div>

    <div class="mt-10 rounded-2xl border border-line bg-white p-6 sm:p-8">
      <h2 class="!mt-0 font-display text-xl font-bold">More states coming</h2>
      <p class="mt-2 text-ink-soft text-sm leading-relaxed">
        We're expanding state by state, starting with the cities whose hotel restaurants
        people actually search for. If there's a hotel dining room you think we should
        cover next, <a href="/contact/" class="text-gold-dark font-semibold hover:underline">let us know</a>.
      </p>
    </div>
  </article>
</BaseLayout>
