---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Hotel Menu Guide",
  url: "https://hotel-menu-guide.pages.dev/",
  description:
    "Independent, original guides to the menus of the most famous hotel restaurants in New York, Ohio, California, and Nevada — what to order, what it costs, and how to plan your visit.",
};
---

<BaseLayout
  title="Hotel Menu Guide — NYC, Ohio, California & Nevada Hotel Restaurant Menus"
  description="Independent, original guides to famous hotel restaurant menus in New York, Ohio, California, and Nevada: The Mark, The Palm Court, King Cole Bar, Café Carlyle, Locanda Verde, Temple Court, Majorelle, Perrine — plus Metropole, The Burnham, Adega, TURN, The Guild House, The Keep, Chateau Marmont, the Polo Lounge, CUT, Sierra Mar, Addison, the Tonga Room, Joël Robuchon, SW Steakhouse, Restaurant Guy Savoy, Nobu, Carbone and Jean Georges Steakhouse. What to order, what it costs, and how to visit."
  path="/"
  jsonLd={jsonLd}
  ogImage="/images/hero-home.webp"
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <img
      src="/images/hero-home.webp"
      alt="Illustration of an elegant New York hotel dining room at dusk"
      class="w-full h-[320px] sm:h-[420px] object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/30 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 pb-8 sm:pb-12">
        <h1 class="font-display text-3xl sm:text-5xl font-bold text-cream leading-tight max-w-2xl">
          Great hotel restaurants, decoded.
        </h1>
        <p class="mt-4 text-cream/85 text-base sm:text-lg max-w-2xl leading-relaxed">
          Independent guides to the menus of famous hotel dining rooms in New York, Ohio, California, and Nevada —
          what to order, what it costs, and how to plan your visit. All written in our own words.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured guides -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 mt-12 sm:mt-16">
    <h2 class="font-display text-2xl sm:text-3xl font-bold">Featured guides: New York</h2>
    <p class="mt-2 text-ink-soft">Eight New York icons, covered in depth. <a href="/best-hotel-restaurants-nyc/" class="text-gold-dark font-semibold hover:underline">See the full ranking →</a></p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <a
        href="/the-mark-menu/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/the-mark-dining.webp"
          alt="Illustration of fine dining at The Mark restaurant"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">Upper East Side · Jean-Georges</p>
          <h3 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            The Mark Restaurant — Menu Guide
          </h3>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            Starters, salads, pizzas, pastas and entrées with reported prices, our picks for what to order,
            and practical visiting advice for the dining room inside The Mark hotel.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Read the guide →</span>
        </div>
      </a>

      <a
        href="/plaza-palm-court-menu/"
        class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
      >
        <img
          src="/images/palm-court-tea.webp"
          alt="Illustration of afternoon tea under the Palm Court's glass dome"
          class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">The Plaza · Fifth Avenue</p>
          <h3 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            The Palm Court Afternoon Tea — Guide
          </h3>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
            Everything about the legendary afternoon tea under the stained-glass dome: the experience,
            reported prices, what to expect, and how to book.
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Read the guide →</span>
        </div>
      </a>

      <a
        href="/king-cole-bar-menu/"
