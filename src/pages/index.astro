        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">Financial District · The Beekman</p>
          <h3 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
            Temple Court — Menu Guide
          </h3>
          <p class="mt-3 text-ink-soft text-sm leading-relaxed">
