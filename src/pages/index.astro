  </section>

  <!-- Ohio guides -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 mt-14 sm:mt-20">
    <h2 class="font-display text-2xl sm:text-3xl font-bold">Featured guides: Ohio</h2>
