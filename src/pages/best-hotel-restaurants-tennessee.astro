---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Best Hotel Restaurants in Tennessee",
  description:
    "Our picks for the best hotel restaurants in Tennessee, each with an original menu guide.",
  itemListElement: [
    { "@type": "ListItem", position: 1, url: "https://hotel-menu-guide.pages.dev/bourbon-steak-nashville-menu/", name: "Bourbon Steak at JW Marriott Nashville" },
    { "@type": "ListItem", position: 2, url: "https://hotel-menu-guide.pages.dev/drusie-and-darr-menu/", name: "Drusie & Darr at The Hermitage Hotel, Nashville" },
    { "@type": "ListItem", position: 3, url: "https://hotel-menu-guide.pages.dev/marsh-house-menu/", name: "Marsh House at Thompson Nashville" },
    { "@type": "ListItem", position: 4, url: "https://hotel-menu-guide.pages.dev/henley-menu/", name: "Henley at Kimpton Aertson Hotel, Nashville" },
    { "@type": "ListItem", position: 5, url: "https://hotel-menu-guide.pages.dev/yolan-menu/", name: "Yolan at The Joseph, Nashville" },
    { "@type": "ListItem", position: 6, url: "https://hotel-menu-guide.pages.dev/the-nashville-grange-menu/", name: "The Nashville Grange at Grand Hyatt Nashville" },
  ],
};

const guides = [
  {
    href: "/bourbon-steak-nashville-menu/",
    img: "/images/bourbon-steak-nashville-dining.webp",
    alt: "Illustration of an elegant modern American steakhouse dining room with warm wood and leather at evening (illustrative, not the actual restaurant)",
    tag: "Nashville · JW Marriott",
    title: "Bourbon Steak",
    text: "Michael Mina's steakhouse on the JW Marriott's 34th floor — the 'Instant' Bacon ($26), filet mignon ($66), and a 40 oz Black Hawk Farms tomahawk ($325), with prices from the official August 2026 menu.",
  },
  {
    href: "/drusie-and-darr-menu/",
    img: "/images/drusie-and-darr-dining.webp",
    alt: "Illustration of a grand historic Southern hotel dining room with high ceilings and chandeliers at evening (illustrative, not the actual restaurant)",
    tag: "Nashville · The Hermitage Hotel",
    title: "Drusie & Darr",
    text: "Jean-Georges Vongerichten's dining room in the historic Hermitage Hotel — the six-course tasting lineup, era-dated reported prices, and the honest note that current prices aren't published.",
  },
  {
    href: "/marsh-house-menu/",
    img: "/images/marsh-house-dining.webp",
    alt: "Illustration of a stylish coastal Southern seafood restaurant dining room with coastal decor at evening (illustrative, not the actual restaurant)",
    tag: "Nashville · Thompson",
    title: "Marsh House",
    text: "Thompson Nashville's coastal Southern seafood room — the $42 Maine lobster roll, snapper courtbouillon, and a $1.50 oyster happy hour, with 2026-era reported prices.",
  },
  {
    href: "/henley-menu/",
    img: "/images/henley-dining.webp",
    alt: "Illustration of a chic modern European-style hotel restaurant dining room with marble tables and candlelight at evening (illustrative, not the actual restaurant)",
    tag: "Nashville · Kimpton Aertson",
    title: "Henley",
    text: "Kimpton Aertson's all-day restaurant on Music Row — biscuit beignets ($12), Nashville 'hot' shrimp & grits, and a diner-reported daily happy hour, with 2026-era reported prices.",
  },
  {
    href: "/yolan-menu/",
    img: "/images/yolan-dining.webp",
    alt: "Illustration of a refined Italian fine-dining room with soft candlelight at evening (illustrative, not the actual restaurant)",
    tag: "Nashville · The Joseph",
    title: "Yolan",
    text: "Tony Mantuano's Italian restaurant at The Joseph — Nashville's only Forbes Star Award-winning restaurant per OpenTable, with prices from official 2026 event menus.",
  },
  {
    href: "/the-nashville-grange-menu/",
    img: "/images/nashville-grange-dining.webp",
    alt: "Illustration of a contemporary Southern-inspired hotel restaurant dining room with city views (illustrative, not the actual restaurant)",
    tag: "Nashville · Grand Hyatt",
    title: "The Nashville Grange",
    text: "Grand Hyatt Nashville's Tennessee-to-table dining room — sweet tea brined chicken, shrimp and grits, and weekend brunch with a Bloody Mary bar. Our guide covers the menu and the honest price picture.",
  },
];
---

<BaseLayout
  title="Best Hotel Restaurants in Tennessee — 6 Great Guides"
  description="Our picks for the best hotel restaurants in Tennessee: Bourbon Steak, Drusie & Darr, Marsh House, Henley, Yolan, and The Nashville Grange — each with an original menu guide."
  path="/best-hotel-restaurants-tennessee/"
  jsonLd={jsonLd}
  ogImage="/images/tennessee-hotel-dining.webp"
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6">
    <img
      src="/images/tennessee-hotel-dining.webp"
      alt="Illustration of a grand Nashville hotel dining room at evening (illustrative, not the actual restaurant)"
      class="w-full h-64 sm:h-96 object-cover rounded-2xl mt-8"
      fetchpriority="high"
    />
    <p class="mt-10 text-xs font-semibold uppercase tracking-widest text-gold-dark">
      Pillar Guide · Tennessee
    </p>
    <h1 class="font-display text-3xl sm:text-5xl font-bold mt-2 leading-tight max-w-3xl">
      The Best Hotel Restaurants in Tennessee
    </h1>
    <p class="mt-3 text-sm text-ink-soft">By <span class="font-semibold text-ink">Firoz Khan</span> <span class="text-gold-dark">&middot;</span> FK Digital Media</p>
    <p class="mt-4 text-lg text-ink-soft leading-relaxed max-w-3xl">
      Nashville's luxury hotels hold some of the South's great dining rooms: Michael
      Mina's Bourbon Steak on the JW Marriott's 34th floor, Jean-Georges's Drusie &amp;
      Darr in the historic Hermitage Hotel, Marsh House's coastal Southern seafood at
      the Thompson, Henley on Music Row, Tony Mantuano's Yolan at The Joseph, and The
      Nashville Grange's Tennessee-to-table cooking at the Grand Hyatt. We've written
      an original, independent guide to each of the six below: what the menu looks
      like, what it costs, and what we'd order. Prices are reported figures, dated
      honestly — never copied menus.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {guides.map((g) => (
        <a
          href={g.href}
          class="group block rounded-2xl overflow-hidden border border-line bg-white shadow-sm hover:shadow-lg transition-shadow"
        >
          <img
            src={g.img}
            alt={g.alt}
            class="w-full h-52 sm:h-60 object-cover group-hover:scale-[1.02] transition-transform duration-300"
            loading="lazy"
          />
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">{g.tag}</p>
            <h2 class="font-display text-xl sm:text-2xl font-bold mt-2 group-hover:text-gold-dark transition-colors">
              {g.title}
            </h2>
            <p class="mt-3 text-ink-soft text-sm leading-relaxed">{g.text}</p>
            <span class="inline-block mt-4 text-sm font-semibold text-gold-dark">Read the guide →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 rounded-2xl bg-parchment border border-line p-6 sm:p-10">
      <h2 class="font-display text-2xl sm:text-3xl font-bold">How we chose these six</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3 text-sm leading-relaxed text-ink-soft">
        <div>
          <p class="font-semibold text-ink mb-2">Search interest</p>
          <p>
            We research every expansion state with Google Trends (US, 12 months) before
            writing a word. Tennessee won our latest research round with a state mean of
            <strong>3.15</strong> — <strong>"bourbon steak nashville menu" at 4.53</strong>
            and <strong>"drusie and darr menu" at 1.77</strong> — beating Pennsylvania,
            Massachusetts, Washington, and North Carolina, and every state we'd built
            before it. One honest caveat: the interest is spike-driven (January and
            March 2026 spikes plus September bumps), not a flat baseline — real
            curiosity, but lumpy.
          </p>
        </div>
        <div>
          <p class="font-semibold text-ink mb-2">All verified open</p>
          <p>
            Every restaurant here was verified open in October 2026 against its official
            site, an active reservation listing, and recent review activity. One
            substitution: Sean Brock's The Continental at the Grand Hyatt closed in
            2023, so we cover the hotel's current all-day dining room, The Nashville
            Grange, instead.
          </p>
        </div>
        <div>
          <p class="font-semibold text-ink mb-2">Our honesty rules</p>
          <p>
            Every guide is written in our own words from official and verified sources.
            Prices are labeled with their date and source — and where a restaurant
            publishes no prices (Drusie &amp; Darr, The Nashville Grange, Marsh House,
            Henley), we say so plainly instead of guessing.
          </p>
        </div>
      </div>
    </div>

    <p class="mt-8 text-sm text-ink-soft">
      <a href="/" class="text-gold-dark font-semibold hover:underline">← Back to all guides</a>
    </p>
  </article>
</BaseLayout>
