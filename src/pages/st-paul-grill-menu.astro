---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: "The St. Paul Grill",
  servesCuisine: ["American", "Steakhouse"],
  priceRange: "$$$$",
  telephone: "+1-651-224-7455",
  url: "https://www.stpaulgrill.com/",
  address: {
    "@type": "PostalAddress",
    streetAddress: "350 Market Street",
    addressLocality: "St. Paul",
    addressRegion: "MN",
    postalCode: "55102",
    addressCountry: "US",
  },
  description:
    "The St. Paul Grill at The Saint Paul Hotel — the Twin Cities' classic supper-club steakhouse, an AAA Four Diamond room with executive chef Gheorghe Vatafu and a wine list the house calls award-winning.",
};
---

<BaseLayout
  title="St. Paul Grill Menu Guide (2026) — Steakhouse at The Saint Paul Hotel | Hotel Menu Guide"
  description="An independent guide to The St. Paul Grill at The Saint Paul Hotel: the classic supper-club steakhouse, hours, menu highlights with prices from the official June 2026 dinner menu, and visiting tips."
  path="/st-paul-grill-menu/"
  jsonLd={jsonLd}
  ogImage="/images/st-paul-grill-dining.webp"
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6">
    <img
      src="/images/st-paul-grill-dining.webp"
      alt="Illustration of a classic American steakhouse supper-club dining room with dark wood paneling and white tablecloths at evening (illustrative, not the actual restaurant)"
      class="w-full h-64 sm:h-96 object-cover rounded-2xl mt-8"
      fetchpriority="high"
    />

    <p class="mt-8 text-xs font-semibold uppercase tracking-widest text-gold-dark">
      Menu Guide · St. Paul
    </p>
    <h1 class="font-display text-3xl sm:text-5xl font-bold mt-2 leading-tight">
      St. Paul Grill — Menu Guide
    </h1>
    <p class="mt-3 text-sm text-ink-soft">By <span class="font-semibold text-ink">Firoz Khan</span> <span class="text-gold-dark">&middot;</span> FK Digital Media</p>
    <p class="mt-4 text-lg text-ink-soft leading-relaxed">
      The St. Paul Grill sits inside <strong>The Saint Paul Hotel</strong> at 350 Market
      Street, the Twin Cities' classic supper-club steakhouse — an
      <strong>AAA Four Diamond</strong> room (per the restaurant's own OpenTable
      listing) run by executive chef <strong>Gheorghe Vatafu</strong>. Prices below
      are from the restaurant's <strong>official June 2026 dinner menu</strong>;
      menu prices reflect a cash discount, with a 3% credit-card surcharge. OpenTable diners keep it busy — 4.6 stars
      across 4,000+ reviews, booked dozens of times a day as of September 2026.
      Everything is written in our own words.
    </p>

    <!-- At a glance -->
    <div class="mt-8 rounded-2xl border border-line bg-white p-6 sm:p-8">
      <h2 class="!mt-0 font-display text-xl font-bold">At a glance</h2>
      <dl class="mt-4 grid gap-3 sm:grid-cols-2 text-sm">
        <div><dt class="font-semibold text-ink">Location</dt><dd class="text-ink-soft">350 Market Street, St. Paul, MN 55102 (The Saint Paul Hotel)</dd></div>
        <div><dt class="font-semibold text-ink">Chef</dt><dd class="text-ink-soft">Executive chef Gheorghe Vatafu</dd></div>
        <div><dt class="font-semibold text-ink">Cuisine</dt><dd class="text-ink-soft">American steakhouse / supper club</dd></div>
        <div><dt class="font-semibold text-ink">Price level</dt><dd class="text-ink-soft">$$$$ — steaks $38.95–$239.95 (official June 2026 dinner menu; prices reflect a cash discount, 3% credit-card surcharge)</dd></div>
        <div><dt class="font-semibold text-ink">Reservations</dt><dd class="text-ink-soft">Via OpenTable, or 651-224-7455</dd></div>
        <div><dt class="font-semibold text-ink">Recognition</dt><dd class="text-ink-soft">AAA Four Diamond (per its OpenTable listing); house calls its wine list "award-winning" (no awarding body named)</dd></div>
      </dl>
    </div>

    <div class="prose-guide">
      <h2>Hours</h2>
      <p>
        Per the OpenTable listing, 2026: <strong>Mon–Sat lunch 11:00 AM–2:00 PM,
        dinner 5:00–9:30 PM; Sunday 4:00–8:30 PM.</strong>
      </p>

      <h2>To start</h2>
      <p>
        Prices below are from the official June 2026 dinner menu
        (prices reflect a cash discount, with a 3% credit-card surcharge):
      </p>
      <ul>
        <li><strong>Wild Rice Soup — cup $8.95 / bowl $15.95</strong>: the Minnesota classic; same soup appears on older 2019-era third-party listings.</li>
        <li><strong>Caesar Salad — $15.95</strong> (starter $8.95); <strong>Grill Wedge — $19.95</strong> (starter $9.95).</li>
      </ul>

      <h2>From the land</h2>
      <ul>
        <li><strong>Top Sirloin (8 oz) — $38.95</strong>: the entry steak.</li>
        <li><strong>Filet Mignon — $59.95–$72.95</strong>.</li>
        <li><strong>Ribeye (14 oz) — $85.95</strong>.</li>
        <li><strong>NY Strip (14 oz, USDA Prime) — $85.95</strong>.</li>
        <li><strong>Lamb T-Bone — $52.95</strong>.</li>
      </ul>

      <h2>From the water</h2>
      <ul>
        <li><strong>Walleye — $38.95</strong>: pan-fried with almond flour and pecan frangelico butter — the Minnesota fish done the supper-club way.</li>
        <li><strong>Salmon — $40.95; Trout — $39.95; Crab Cakes — $52.95; Scallops — $58.95</strong>.</li>
        <li><strong>Lobster Tail — $69.95</strong>.</li>
      </ul>

      <h2>What we'd order</h2>
      <p>If we had one dinner here, this is how we'd play it:</p>
      <ul>
        <li><strong>Start with:</strong> the wild rice soup — it's the regional rite of passage.</li>
        <li><strong>The fish play:</strong> the walleye ($38.95) if you want the Minnesota answer.</li>
        <li><strong>Steakhouse mode:</strong> the filet ($59.95–$72.95) — the sweet spot before the big cuts.</li>
        <li><strong>The splurge:</strong> the 50 oz Tomahawk ($239.95), ideally split.</li>
        <li><strong>After dinner:</strong> linger — this is a supper club; the room rewards staying a while.</li>
      </ul>

      <h2>Planning your visit</h2>
      <ul>
        <li><strong>Book ahead</strong> — dozens of OpenTable bookings a day; weekends go fast.</li>
        <li><strong>Prices are from the official June 2026 dinner menu:</strong> confirm current prices with the restaurant.</li>
        <li><strong>Sunday hours are shorter:</strong> 4:00–8:30 PM only, per the 2026 listing.</li>
        <li><strong>Parking:</strong> valet is available at The Saint Paul Hotel.</li>
      </ul>

      <h2>Official links</h2>
      <ul>
        <li><a href="https://www.stpaulgrill.com/" target="_blank" rel="noopener">Official restaurant site — The St. Paul Grill</a></li>
        <li><a href="https://www.opentable.com/r/the-st-paul-grill" target="_blank" rel="noopener">Reservations — OpenTable</a></li>
      </ul>
    </div>

    <!-- Price disclaimer -->
    <div class="mt-10 rounded-xl border border-gold/40 bg-gold/10 p-5 text-sm text-ink-soft leading-relaxed">
      <p class="font-semibold text-ink mb-1">About these prices</p>
      <p>
        All prices above are from the <strong>official June 2026 dinner menu</strong>.
        Menu prices reflect a cash discount, with a 3% credit-card surcharge.
        Always verify with the restaurant before visiting.
      </p>
    </div>

    <!-- Related guides -->
    <div class="mt-10 rounded-2xl border border-line bg-white p-6 sm:p-8">
      <h2 class="!mt-0 font-display text-xl font-bold">More Minnesota guides</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li><a href="/best-hotel-restaurants-minnesota/" class="text-gold-dark font-semibold hover:underline">The best hotel restaurants in Minnesota →</a></li>
        <li><a href="/mannys-menu/" class="text-gold-dark font-semibold hover:underline">Manny's Steakhouse</a> <span class="text-ink-soft">— the landmark steakhouse at W Minneapolis–The Foshay</span></li>
        <li><a href="/firelake-menu/" class="text-gold-dark font-semibold hover:underline">FireLake Grill House</a> <span class="text-ink-soft">— farm-to-table at Radisson Blu Mall of America</span></li>
        <li><a href="/mara-minneapolis-menu/" class="text-gold-dark font-semibold hover:underline">Mara</a> <span class="text-ink-soft">— Mediterranean at the Four Seasons Minneapolis</span></li>
      </ul>
    </div>

    <p class="mt-8 text-sm text-ink-soft">
      <a href="/" class="text-gold-dark font-semibold hover:underline">← Back to all guides</a>
    </p>
  </article>
</BaseLayout>
